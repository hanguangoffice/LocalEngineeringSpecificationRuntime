{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/kind-definition.schema.json",
  "title": "Kind Definition Revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_type", "kind_uid", "revision_uid", "name", "core_class", "required_facet_revision_uids", "content_hash"],
  "properties": {
    "schema_version": {"const": "1.0"}, "resource_type": {"const": "kind_definition_revision"},
    "kind_uid": {"$ref": "common.schema.json#/$defs/uuid7"}, "revision_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "name": {"type": "string", "minLength": 1}, "core_class": {"type": "string", "minLength": 1},
    "required_facet_revision_uids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/uuid7"}},
    "optional_facet_revision_uids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/uuid7"}},
    "replaceable": {"type": "boolean"}, "authority": {"type":"integer","minimum":0}, "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
