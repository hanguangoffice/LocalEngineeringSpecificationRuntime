{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://lesr.dev/schemas/v1/task-record.schema.json","title":"Local Runtime Task Record","description":"Operational state stored only in .lesr runtime database; only completed high-risk result anchors may enter Canonical Git.","type":"object","additionalProperties":false,"required":["schema_version","resource_type","task_uid","task_type","state","progress","request_hash","created_at","updated_at"],"properties":{"schema_version":{"const":"1.0"},"resource_type":{"const":"task_record"},"task_uid":{"$ref":"common.schema.json#/$defs/uuid7"},"task_type":{"enum":["full_validation","deep_trace","migration","backup","large_impact"]},"state":{"enum":["queued","running","cancelling","cancelled","failed","completed","interrupted"]},"progress":{"type":"integer","minimum":0,"maximum":100},"request_hash":{"$ref":"common.schema.json#/$defs/sha256"},"checkpoint_hash":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},"result_hash":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},"error":{"type":["string","null"]},"created_at":{"$ref":"common.schema.json#/$defs/utc_timestamp"},"updated_at":{"$ref":"common.schema.json#/$defs/utc_timestamp"}}}
