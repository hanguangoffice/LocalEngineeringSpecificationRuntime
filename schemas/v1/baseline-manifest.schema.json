{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/baseline-manifest.schema.json",
  "title": "LESR Baseline Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_type", "baseline_uid", "state_commit", "configuration_uid", "exact_revision_uids", "exact_relation_revision_uids", "effective_model_hash", "deviation_revision_uids", "review_package_hash", "created_at", "manifest_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "resource_type": {"const": "baseline_manifest"},
    "baseline_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "state_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "exact_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "exact_relation_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "configuration_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "effective_model_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "deviation_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "review_package_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "created_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "manifest_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
