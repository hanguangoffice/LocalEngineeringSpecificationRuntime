{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/baseline-manifest.schema.json",
  "title": "LESR Baseline Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_type", "baseline_uid", "git_commit", "revision_uids", "relation_revision_uids", "profile_revision_uids", "configuration_uid", "effective_model_hash", "deviation_revision_uids", "external_references", "created_at", "manifest_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "resource_type": {"const": "baseline_manifest"},
    "baseline_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "relation_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "profile_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "configuration_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "effective_model_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "deviation_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "external_references": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/canonical_value"}},
    "evidence_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "created_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "manifest_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
