{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/configuration.schema.json",
  "title": "LESR Configuration Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_type", "configuration_uid", "base_commit", "state_anchor", "revision_uids", "relation_revision_uids", "profile_revision_uids", "active_deviation_revision_uids", "effective_model_hash", "closure_status", "created_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "resource_type": {"const": "configuration_snapshot"},
    "configuration_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "parent_configuration_uid": {"oneOf": [{"$ref": "common.schema.json#/$defs/uuid7"}, {"type": "null"}]},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "state_anchor": {"$ref": "common.schema.json#/$defs/sha256"},
    "revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "relation_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "profile_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "active_deviation_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "active_exception_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true, "default": []},
    "conflict_resolution_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true, "default": []},
    "variant": {"type": ["string", "null"]},
    "valid_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/utc_timestamp"}, {"type": "null"}]},
    "effective_model_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "closure_status": {"enum": ["complete", "partial", "indeterminate"]},
    "closure_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "configuration_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
