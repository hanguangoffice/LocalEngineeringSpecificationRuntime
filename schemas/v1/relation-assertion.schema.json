{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/relation-assertion.schema.json",
  "title": "LESR Relation Assertion Revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_type", "assertion_uid", "relation_revision_uid", "revision_number", "predicate", "core_role", "source", "target", "scope", "provenance_kind", "formal_trace_categories", "created_at", "content_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "resource_type": {"const": "relation_assertion_revision"},
    "assertion_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "relation_revision_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "revision_number": {"type": "integer", "minimum": 1},
    "parent_relation_revision_uid": {"oneOf": [{"$ref": "common.schema.json#/$defs/uuid7"}, {"type": "null"}]},
    "predicate": {"$ref": "common.schema.json#/$defs/non_empty"},
    "core_role": {"enum": ["organizes", "composes", "refines", "realizes", "verifies", "constrains", "applies_to", "depends_on", "impacts", "evidences", "governs", "authorizes", "derives_from", "supersedes", "conflicts_with", "references"]},
    "source": {"$ref": "common.schema.json#/$defs/relation_endpoint"},
    "target": {"$ref": "common.schema.json#/$defs/relation_endpoint"},
    "scope": {"$ref": "common.schema.json#/$defs/non_empty"},
    "provenance_kind": {"$ref": "common.schema.json#/$defs/provenance_kind"},
    "formal_trace_categories": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "rationale": {"type": ["string", "null"]},
    "created_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "examples": [{"schema_version":"1.0","resource_type":"relation_assertion_revision","assertion_uid":"018f0000-0000-7000-8000-000000000003","relation_revision_uid":"018f0000-0000-7000-8000-000000000004","revision_number":1,"parent_relation_revision_uid":null,"predicate":"verifies","core_role":"verifies","source":{"binding":"logical","object_uid":"018f0000-0000-7000-8000-000000000001"},"target":{"binding":"pinned","object_uid":"018f0000-0000-7000-8000-000000000005","revision_uid":"018f0000-0000-7000-8000-000000000006"},"scope":"project","provenance_kind":"asserted","formal_trace_categories":["verification"],"rationale":"Reviewed trace","created_at":"2026-08-05T00:00:00Z","content_hash":"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}]
}
