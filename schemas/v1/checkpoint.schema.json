{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://lesr.dev/schemas/v1/checkpoint.schema.json","title":"Workspace Checkpoint","type":"object","additionalProperties":false,"required":["schema_version","resource_type","checkpoint_uid","workspace_uid","base_commit","working_state_hash","edit_scope","actor_uid","validation_summary","created_at","git_ref","checkpoint_hash"],"properties":{"schema_version":{"const":"1.0"},"resource_type":{"const":"workspace_checkpoint"},"checkpoint_uid":{"$ref":"common.schema.json#/$defs/uuid7"},"workspace_uid":{"$ref":"common.schema.json#/$defs/uuid7"},"base_commit":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"working_state_hash":{"$ref":"common.schema.json#/$defs/sha256"},"edit_scope":{"type":"array","items":{"$ref":"common.schema.json#/$defs/uuid7"}},"actor_uid":{"type":"string"},"validation_summary":{"type":"object"},"created_at":{"$ref":"common.schema.json#/$defs/utc_timestamp"},"git_ref":{"type":"string","pattern":"^refs/lesr/workspaces/"},"checkpoint_hash":{"$ref":"common.schema.json#/$defs/sha256"}}}
