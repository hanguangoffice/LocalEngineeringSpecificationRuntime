{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://lesr.dev/schemas/v1/provenance.schema.json",
  "title":"LESR Provenance Record",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","resource_type","provenance_uid","subject_uid","kind","responsible_actor_uid","tool_uids","delegation_uid","source_uids","generated_at","content_hash"],
  "properties":{
    "schema_version":{"$ref":"common.schema.json#/$defs/schema_version"},
    "resource_type":{"const":"provenance_record"},
    "provenance_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "subject_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "kind":{"$ref":"common.schema.json#/$defs/provenance_kind"},
    "responsible_actor_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "tool_uids":{"type":"array","items":{"$ref":"common.schema.json#/$defs/uuid7"},"uniqueItems":true},
    "delegation_uid":{"oneOf":[{"$ref":"common.schema.json#/$defs/uuid7"},{"type":"null"}]},
    "source_uids":{"type":"array","items":{"$ref":"common.schema.json#/$defs/uuid7"},"uniqueItems":true},
    "generated_at":{"$ref":"common.schema.json#/$defs/utc_timestamp"},
    "content_hash":{"$ref":"common.schema.json#/$defs/sha256"}
  }
}
