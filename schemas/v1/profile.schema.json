{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/profile.schema.json",
  "title": "LESR Profile Revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_type", "profile_uid", "profile_revision_uid", "profile_kind", "resource_kinds", "relation_types", "rule_revision_uids", "configuration_policies", "review_policies", "content_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "resource_type": {"const": "profile_revision"},
    "profile_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "profile_revision_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "profile_kind": {"enum": ["core", "domain", "project", "tool_mapping", "tailoring"]},
    "resource_kinds": {"type": "array", "items": {"oneOf": [{"type":"string","minLength":1},{"$ref":"#/$defs/resource_kind"}]}, "uniqueItems": true},
    "relation_types": {"type": "array", "items": {"oneOf": [{"type":"string","minLength":1},{"$ref":"#/$defs/relation_type"}]}, "uniqueItems": true},
    "rule_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "configuration_policies": {"type": "array", "items": {"$ref":"#/$defs/configuration_policy"}},
    "review_policies": {"type": "array", "items": {"$ref":"#/$defs/review_policy"}},
    "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "resource_kind": {
      "type":"object","additionalProperties":false,"required":["kind","fields"],
      "properties": {
        "kind":{"type":"string","minLength":1},
        "fields":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","type"],"properties":{"path":{"type":"string","minLength":1},"type":{"enum":["string","integer","boolean","quantity","path","canonical"]},"unit":{"type":["string","null"]}}}}
      }
    },
    "relation_type": {
      "type":"object","additionalProperties":false,"required":["predicate"],
      "properties":{"predicate":{"type":"string","minLength":1},"core_role":{"type":"string"},"source_kinds":{"type":"array","items":{"type":"string"}},"target_kinds":{"type":"array","items":{"type":"string"}}}
    },
    "configuration_policy": {
      "type":"object","additionalProperties":false,
      "properties": {
        "latest_fallback":{"type":"boolean"},
        "units":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["unit","dimension","scale_to_base"],"properties":{"unit":{"type":"string","minLength":1},"dimension":{"type":"string","minLength":1},"scale_to_base":{"type":"string","pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"}}}},
        "context":{"type":"object","additionalProperties":{"$ref":"#/$defs/context_policy"}}
      }
    },
    "context_policy": {
      "type":"object","additionalProperties":false,
      "properties":{"mandatory_predicates":{"type":"array","items":{"type":"string"},"uniqueItems":true},"conditional_predicates":{"type":"array","items":{"type":"string"},"uniqueItems":true},"invariant_object_uids":{"type":"array","items":{"$ref":"common.schema.json#/$defs/uuid7"},"uniqueItems":true},"forbidden_sensitivities":{"type":"array","items":{"type":"string"},"uniqueItems":true}}
    },
    "review_policy": {
      "type":"object","additionalProperties":false,"required":["operation","required_roles","minimum_approval_count"],
      "properties":{"operation":{"type":"string","minLength":1},"required_roles":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"minimum_approval_count":{"type":"integer","minimum":1},"require_preparer_independence":{"type":"boolean"},"blocking_effects":{"type":"array","items":{"enum":["allow","allow_with_observation","require_acknowledgement","require_review","require_deviation","block_operation"]},"uniqueItems":true}}
    }
  }
}
