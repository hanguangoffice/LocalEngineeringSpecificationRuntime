{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://lesr.dev/schemas/v1/facet-definition.schema.json",
  "title": "Facet Definition Revision", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "resource_type", "facet_uid", "revision_uid", "name", "capabilities", "fields", "fragments", "content_hash"],
  "properties": {
    "schema_version": {"const": "1.0"}, "resource_type": {"const": "facet_definition_revision"},
    "facet_uid": {"$ref": "common.schema.json#/$defs/uuid7"}, "revision_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "name": {"type": "string", "minLength": 1}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "fragments": {"type": "array", "items": {"$ref": "#/$defs/fragment"}},
    "replaceable": {"type": "boolean"}, "authority": {"type":"integer","minimum":0}, "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "value_type", "required", "enum_values"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "value_type": {"enum": ["string", "integer", "boolean", "object", "array", "quantity", "timestamp"]},
        "required": {"type": "boolean"}, "unit": {"type": ["string", "null"]},
        "minimum": {"type": ["string", "null"]}, "maximum": {"type": ["string", "null"]},
        "enum_values": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/canonical_value"}},
        "minimum_items": {"type": ["integer", "null"], "minimum": 0},
        "maximum_items": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "fragment": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "minimum_count", "fields"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "minimum_count": {"type": "integer", "minimum": 0},
        "maximum_count": {"type": ["integer", "null"], "minimum": 0},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}
      }
    }
  }
}
