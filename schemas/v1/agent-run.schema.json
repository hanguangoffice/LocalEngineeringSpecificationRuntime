{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/agent-run.schema.json",
  "title": "Local Runtime Agent Run",
  "description": "One local provider execution attempt. AgentRun is operational state and is ineligible for Canonical Git.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "resource_type", "persistence_scope", "canonical_git_eligible",
    "agent_run_uid", "mission_uid", "work_package_uid", "role", "provider",
    "model_identifier", "client", "session_id", "attempt", "state", "result_summary",
    "error_summary", "created_at", "updated_at", "started_at", "finished_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "resource_type": {"const": "agent_run"},
    "persistence_scope": {"const": "local_runtime"},
    "canonical_git_eligible": {"const": false},
    "agent_run_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "mission_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "work_package_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "role": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model_identifier": {"type": "string", "minLength": 1},
    "client": {"type": "string", "minLength": 1},
    "session_id": {"type": ["string", "null"], "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "state": {"enum": ["queued", "running", "completed", "failed", "cancelled", "interrupted"]},
    "result_summary": {"type": ["string", "null"], "minLength": 1},
    "error_summary": {"type": ["string", "null"], "minLength": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "started_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/utc_timestamp"}, {"type": "null"}]},
    "finished_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/utc_timestamp"}, {"type": "null"}]}
  }
}
