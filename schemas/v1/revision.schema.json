{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/revision.schema.json",
  "title": "LESR Immutable Revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_type", "revision_uid", "object_uid", "revision_number", "human_key", "kind", "facets", "fields", "fragments", "provenance_origin", "created_at", "content_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "resource_type": {"const": "revision"},
    "revision_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "object_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "revision_number": {"type": "integer", "minimum": 1},
    "parent_revision_uid": {"oneOf": [{"$ref": "common.schema.json#/$defs/uuid7"}, {"type": "null"}]},
    "human_key": {"$ref": "common.schema.json#/$defs/non_empty"},
    "kind": {"$ref": "common.schema.json#/$defs/non_empty"},
    "facets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "fields": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/semantic_field"}},
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_key", "fields"],
        "properties": {
          "local_key": {"$ref": "common.schema.json#/$defs/non_empty"},
          "fields": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/semantic_field"}}
        }
      }
    },
    "provenance_origin": {"$ref": "common.schema.json#/$defs/provenance_kind"},
    "created_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "examples": [{"schema_version":"1.0","resource_type":"revision","revision_uid":"018f0000-0000-7000-8000-000000000002","object_uid":"018f0000-0000-7000-8000-000000000001","revision_number":1,"parent_revision_uid":null,"human_key":"REQ-1","kind":"software_requirement","facets":["authored"],"fields":[{"path":"/statement","value":"The client shall reconnect."}],"fragments":[],"provenance_origin":"authored","created_at":"2026-08-05T00:00:00Z","content_hash":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]
}
