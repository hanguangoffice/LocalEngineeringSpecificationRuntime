{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://lesr.dev/schemas/v1/trusted-actor.schema.json",
  "title":"LESR Trusted Actor Key",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","resource_type","actor_uid","actor_type","display_name","roles","key_uid","algorithm","public_key","valid_from","revoked_by_record_uid"],
  "properties":{
    "schema_version":{"$ref":"common.schema.json#/$defs/schema_version"},
    "resource_type":{"const":"trusted_actor"},
    "actor_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "actor_type":{"const":"human"},
    "display_name":{"type":"string","minLength":1},
    "roles":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "key_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "algorithm":{"const":"Ed25519"},
    "public_key":{"type":"string","contentEncoding":"base64","minLength":40},
    "valid_from":{"$ref":"common.schema.json#/$defs/utc_timestamp"},
    "valid_to":{"oneOf":[{"$ref":"common.schema.json#/$defs/utc_timestamp"},{"type":"null"}]},
    "revoked_by_record_uid":{"oneOf":[{"$ref":"common.schema.json#/$defs/uuid7"},{"type":"null"}]}
  }
}
