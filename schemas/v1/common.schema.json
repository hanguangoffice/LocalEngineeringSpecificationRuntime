{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/common.schema.json",
  "title": "LESR v1 common definitions",
  "$defs": {
    "schema_version": {"const": "1.0"},
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "non_empty": {"type": "string", "minLength": 1},
    "canonical_value": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/canonical_value"}},
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/canonical_value"}
        }
      ]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decimal", "unit"],
      "properties": {
        "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "semantic_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value"],
      "properties": {
        "path": {"type": "string", "pattern": "^/([^/~]|~[01])+(?:/([^/~]|~[01])+)*$"},
        "value": {"$ref": "#/$defs/canonical_value"}
      }
    },
    "provenance_kind": {
      "enum": ["authored", "imported", "observed", "asserted", "inferred", "proposed", "generated"]
    },
    "actor_type": {"enum": ["human", "ai", "tool", "system"]},
    "risk_class": {"enum": ["low", "medium", "high"]},
    "relation_endpoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["binding", "object_uid"],
          "properties": {
            "binding": {"const": "logical"},
            "object_uid": {"$ref": "#/$defs/uuid7"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["binding", "object_uid", "revision_uid"],
          "properties": {
            "binding": {"const": "pinned"},
            "object_uid": {"$ref": "#/$defs/uuid7"},
            "revision_uid": {"$ref": "#/$defs/uuid7"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["binding", "object_uid", "revision_uid", "fragment_path"],
          "properties": {
            "binding": {"const": "fragment"},
            "object_uid": {"$ref": "#/$defs/uuid7"},
            "revision_uid": {"$ref": "#/$defs/uuid7"},
            "fragment_path": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["binding", "system", "namespace", "external_id"],
          "properties": {
            "binding": {"const": "external"},
            "system": {"type": "string", "minLength": 1},
            "namespace": {"type": "string", "minLength": 1},
            "external_id": {"type": "string", "minLength": 1},
            "external_revision": {"type": ["string", "null"]},
            "uri": {"type": ["string", "null"], "format": "uri"},
            "source_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
          }
        }
      ]
    }
  }
}
