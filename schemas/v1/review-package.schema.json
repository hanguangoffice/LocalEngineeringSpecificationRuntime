{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/review-package.schema.json",
  "title": "LESR Immutable Review Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_type", "package_uid", "workspace_uid", "base_commit", "configuration_uid", "candidate_hash", "base_revision_uids", "candidate_revision_uids", "relation_changes", "disposition_changes", "semantic_diff", "impact_analysis", "validation_run_uids", "validation_summary_hash", "open_finding_uids", "effective_model_hash", "evaluation_context_hash", "prepared_by_actor_uid", "required_review_roles", "minimum_approval_count", "preparer_independence_required", "created_at", "package_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "resource_type": {"const": "review_package"},
    "package_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "workspace_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "configuration_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "candidate_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "base_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "candidate_revision_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "relation_changes": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/canonical_value"}},
    "disposition_changes": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/canonical_value"}},
    "semantic_diff": {"$ref": "common.schema.json#/$defs/canonical_value"},
    "impact_analysis": {"$ref": "common.schema.json#/$defs/canonical_value"},
    "validation_run_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "validation_summary_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "open_finding_uids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "effective_model_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "evaluation_context_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "prepared_by_actor_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "required_review_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "minimum_approval_count": {"type": "integer", "minimum": 1},
    "preparer_independence_required": {"type": "boolean"},
    "created_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "package_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
