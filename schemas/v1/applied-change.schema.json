{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://lesr.dev/schemas/v1/applied-change.schema.json",
  "title":"LESR Applied Change Record",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","resource_type","transaction_uid","transaction_hash","base_commit","expected_revisions","effective_model_hash","review_package_hash","operation_hashes","approval_uids","provenance_uids","audit_anchor_uid","actor_uid","delegation_uid","idempotency_key_hash","applied_at"],
  "properties":{
    "schema_version":{"$ref":"common.schema.json#/$defs/schema_version"},
    "resource_type":{"const":"applied_change"},
    "transaction_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "transaction_hash":{"$ref":"common.schema.json#/$defs/sha256"},
    "base_commit":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},
    "expected_revisions":{"type":"array","items":{"$ref":"common.schema.json#/$defs/canonical_value"}},
    "effective_model_hash":{"$ref":"common.schema.json#/$defs/sha256"},
    "review_package_hash":{"$ref":"common.schema.json#/$defs/sha256"},
    "operation_hashes":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/sha256"}},
    "approval_uids":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/uuid7"},"uniqueItems":true},
    "provenance_uids":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/uuid7"},"uniqueItems":true},
    "audit_anchor_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "actor_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "delegation_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "idempotency_key_hash":{"$ref":"common.schema.json#/$defs/sha256"},
    "applied_at":{"$ref":"common.schema.json#/$defs/utc_timestamp"}
  }
}
