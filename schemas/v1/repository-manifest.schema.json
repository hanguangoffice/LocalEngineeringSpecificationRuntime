{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/repository-manifest.schema.json",
  "title": "LESR 1.0 Repository Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_type", "canonical_format_version", "runtime_contract_version", "schema_catalog", "capabilities", "compatibility", "repository_scope", "manifest_hash"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "resource_type": {"const": "repository_manifest"},
    "canonical_format_version": {"const": "1.0.0"},
    "runtime_contract_version": {"const": "1.0.0"},
    "schema_catalog": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+\\.schema\\.json$"}},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "capability-descriptor.schema.json"}},
    "compatibility": {"const": "breaking_from_0.5_no_migration"},
    "repository_scope": {"const": "local_single_repository_single_user"},
    "manifest_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
