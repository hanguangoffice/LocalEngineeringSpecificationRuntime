{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesr.dev/schemas/v1/semantic-transaction.schema.json",
  "title": "LESR Semantic Transaction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_type", "transaction_uid", "workspace_uid", "base_commit", "expected_revisions", "effective_model_hash", "review_package_hash", "operations", "approval_uids", "actor_uid", "delegation_uid", "idempotency_key", "risk_class"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "resource_type": {"const": "semantic_transaction"},
    "transaction_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "workspace_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "expected_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_uid", "revision_uid"],
        "properties": {
          "object_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
          "revision_uid": {"$ref": "common.schema.json#/$defs/uuid7"}
        }
      }
    },
    "effective_model_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "review_package_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_type", "target", "payload"],
        "properties": {
          "operation_type": {"enum": ["create_logical_object", "create_revision", "set_disposition", "assert_relation", "retire_relation", "create_record", "retract_record", "create_deviation", "revoke_deviation", "update_profile_binding", "create_configuration", "create_baseline", "promote_fragment", "split_object", "consolidate_object"]},
          "target": {"type": "string", "minLength": 1},
          "payload": {"$ref": "common.schema.json#/$defs/canonical_value"}
        }
      }
    },
    "approval_uids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/uuid7"}, "uniqueItems": true},
    "actor_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "delegation_uid": {"$ref": "common.schema.json#/$defs/uuid7"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 200},
    "risk_class": {"$ref": "common.schema.json#/$defs/risk_class"}
  }
}
