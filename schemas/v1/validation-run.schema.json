{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://lesr.dev/schemas/v1/validation-run.schema.json",
  "title":"LESR Candidate Validation Run",
  "type":"object","additionalProperties":false,
  "required":["schema_version","resource_type","validation_run_uid","workspace_uid","base_commit","configuration_uid","effective_model_hash","candidate_hash","observations","finding_uids","outcome","completed_at","content_hash"],
  "properties":{
    "schema_version":{"$ref":"common.schema.json#/$defs/schema_version"},
    "resource_type":{"const":"validation_run"},
    "validation_run_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "workspace_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "base_commit":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},
    "configuration_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "effective_model_hash":{"$ref":"common.schema.json#/$defs/sha256"},
    "candidate_hash":{"$ref":"common.schema.json#/$defs/sha256"},
    "observations":{"type":"array","items":{"$ref":"#/$defs/observation"}},
    "finding_uids":{"type":"array","items":{"$ref":"common.schema.json#/$defs/uuid7"},"uniqueItems":true},
    "outcome":{"enum":["pass","fail","indeterminate"]},
    "completed_at":{"$ref":"common.schema.json#/$defs/utc_timestamp"},
    "content_hash":{"$ref":"common.schema.json#/$defs/sha256"}
  },
  "$defs":{"observation":{"type":"object","additionalProperties":false,"required":["observation_uid","rule_uid","rule_revision_uid","target_uid","outcome","enforcement","explanation"],"properties":{"observation_uid":{"$ref":"common.schema.json#/$defs/uuid7"},"rule_uid":{"$ref":"common.schema.json#/$defs/uuid7"},"rule_revision_uid":{"$ref":"common.schema.json#/$defs/uuid7"},"target_uid":{"$ref":"common.schema.json#/$defs/uuid7"},"target_revision_uid":{"oneOf":[{"$ref":"common.schema.json#/$defs/uuid7"},{"type":"null"}]},"outcome":{"enum":["pass","fail","not_applicable","indeterminate","suppressed_by_deviation","evaluator_error","not_evaluated"]},"enforcement":{"enum":["allow","allow_with_observation","require_acknowledgement","require_review","require_deviation","block_operation"]},"explanation":{"$ref":"common.schema.json#/$defs/canonical_value"}}}}
}
