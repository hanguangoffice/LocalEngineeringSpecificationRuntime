{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://lesr.dev/schemas/v1/audit-anchor.schema.json",
  "title":"LESR Audit Anchor",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","resource_type","anchor_uid","transaction_uid","previous_anchor_hash","event_hashes","created_at","anchor_hash"],
  "properties":{
    "schema_version":{"$ref":"common.schema.json#/$defs/schema_version"},
    "resource_type":{"const":"audit_anchor"},
    "anchor_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "transaction_uid":{"$ref":"common.schema.json#/$defs/uuid7"},
    "previous_anchor_hash":{"oneOf":[{"$ref":"common.schema.json#/$defs/sha256"},{"type":"null"}]},
    "event_hashes":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/sha256"}},
    "created_at":{"$ref":"common.schema.json#/$defs/utc_timestamp"},
    "anchor_hash":{"$ref":"common.schema.json#/$defs/sha256"}
  }
}
